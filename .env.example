# Copiá este archivo como `.env` y ajustá los valores.
DEBUG=True
SECRET_KEY=cambiá-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Base de datos y Redis (los hosts `db` y `redis` son los de docker-compose)
DATABASE_URL=postgres://sistemkios:sistemkios@db:5432/sistemkios
REDIS_URL=redis://redis:6379/0

# Super Admin inicial (se crea solo si no existe)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiá-esta-contraseña
DJANGO_SUPERUSER_EMAIL=admin@sistemkios.local
