# Copiá este archivo como `.env` y ajustá los valores.
DEBUG=True
SECRET_KEY=cambiá-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Base de datos (el host `db` es el de docker-compose)
DATABASE_URL=postgres://sistemkios:sistemkios@db:5432/sistemkios

# Super Admin inicial (se crea solo si no existe)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiá-esta-contraseña
DJANGO_SUPERUSER_EMAIL=admin@sistemkios.local

# --- Supabase (opcional en local) --------------------------------------------
# Sin estas variables la app anda igual: sin tiempo real y con las imágenes en disco.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<clave anon / publishable>
# Firma de los tokens de Realtime: una de las dos.
# SUPABASE_JWT_SECRET=<JWT secret (HS256)>
# SUPABASE_JWT_PRIVATE_KEY=<PEM en una línea, con 
>   y   SUPABASE_JWT_KID=<id de la clave>
# Imágenes en Supabase Storage (Storage > S3 connection):
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_S3_REGION=sa-east-1
# SUPABASE_BUCKET=media

# --- Producción (Vercel + Supabase) -----------------------------------------
# En Vercel (Settings > Environment Variables, solo entorno Production):
#   SECRET_KEY, DJANGO_SUPERUSER_*, todas las SUPABASE_* de arriba, y
#   DATABASE_URL              = pooler de Supabase, modo transacción (puerto 6543)
#   DATABASE_URL_MIGRACIONES  = pooler de Supabase, modo sesión (puerto 5432)
# DEBUG no se setea (queda en False). Los dominios de Vercel se agregan solos.
